<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Barre d outils -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_purple"
        app:title="@string/title_detail"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:menu="@menu/menu_detail"
        android:elevation="4dp" />

    <!-- Formulaire scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Section Photo -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPhoto"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    app:cardCornerRadius="55dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageView
                        android:id="@+id/ivDetailPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_default_avatar"
                        android:contentDescription="Photo" />
                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/ivCameraBadge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignEnd="@id/cardPhoto"
                    android:layout_alignBottom="@id/cardPhoto"
                    android:background="@drawable/bg_circle_camera"
                    android:padding="6dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/white"
                    android:contentDescription="Camera" />
            </RelativeLayout>

            <!-- Champ Nom -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_nom"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etNom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_nom"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:inputType="textPersonName|textCapWords"
                android:layout_marginBottom="14dp" />

            <!-- Champ Prenom -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_prenom"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPrenom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_prenom"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:inputType="textPersonName|textCapWords"
                android:layout_marginBottom="14dp" />

            <!-- Champ Telephone + Bouton Appeler -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_telephone"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <EditText
                    android:id="@+id/etTelephone"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_telephone"
                    android:paddingHorizontal="12dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:inputType="phone" />

                <ImageButton
                    android:id="@+id/btnAppeler"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_btn_call"
                    android:src="@drawable/ic_call"
                    app:tint="@color/white"
                    android:contentDescription="@string/btn_appeler" />
            </LinearLayout>

            <!-- Champ E-mail + Bouton Envoyer e-mail -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_email"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_email"
                    android:paddingHorizontal="12dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:inputType="textEmailAddress" />

                <ImageButton
                    android:id="@+id/btnEmail"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_btn_email"
                    android:src="@drawable/ic_email"
                    app:tint="@color/white"
                    android:contentDescription="@string/btn_email" />
            </LinearLayout>

            <!-- Boutons Photo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChoisirPhoto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_photo"
                    app:backgroundTint="@color/purple_action"
                    android:text="@string/btn_choisir_photo"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_gallery"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrendrePhoto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_photo"
                    app:backgroundTint="@color/purple_action"
                    android:text="@string/btn_prendre_photo"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_camera"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Bouton Enregistrer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnregistrer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_btn_save"
                app:backgroundTint="@color/green_action"
                android:text="@string/btn_enregistrer"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                android:layout_marginBottom="10dp" />

            <!-- Bouton Annuler -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnnuler"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_annuler"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>